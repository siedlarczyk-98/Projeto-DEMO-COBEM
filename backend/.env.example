# --- Banco ---
DATABASE_URL="postgresql://cobem:cobem@localhost:5433/cobem?schema=public"

# --- Paciente 360 ---
P360_BASE_URL="https://api.paciente360.com.br/integration"
P360_CLIENT_ID=""
P360_CLIENT_KEY=""

# Opcionais do payload (deixe vazio para nao enviar)
P360_CURSO_ID=""
P360_BACK_URL=""
P360_CLASS_ID=""
P360_CLIENT_LANG="pt-br"

# --- RD Station Marketing ---
# Escolha UMA das autenticacoes. OAuth tem precedencia sobre a chave publica.
# Sem nenhuma delas o envio fica desativado (o lead continua sendo salvo).

# 1) OAuth (recomendado em producao) - App Store > seu app > callback
RD_CLIENT_ID=""
RD_CLIENT_SECRET=""
RD_REFRESH_TOKEN=""

# 2) Chave publica (mais simples para a demo) - Integracoes > API
RD_PUBLIC_API_KEY=""

# Identificador da conversao: e por ele que a automacao/regua e disparada.
RD_CONVERSION_IDENTIFIER="cobem-2026-lp"

# Tags aplicadas ao contato (separadas por virgula). O perfil vira uma tag
# automatica (perfil-aluno / perfil-professor) para segmentar a regua.
RD_TAGS="cobem-2026,evento"

# Nome de API de um campo customizado para gravar ALUNO/PROFESSOR.
# So preencha se o campo JA existir na conta, senao o RD devolve 400.
RD_CAMPO_PERFIL=""

RD_TIMEOUT_MS=8000

# --- App ---
# PORT e injetada pelo Railway em producao
PORT=3000

# So preencha se um front EXTERNO for consumir esta API.
# Em servico unico a LP e servida pela mesma origem e CORS nao e necessario.
CORS_ORIGIN=""
