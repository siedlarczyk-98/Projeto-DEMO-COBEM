generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  ALUNO
  PROFESSOR
  COORDENADOR
  REITORIA
}

enum RdStatus {
  PENDENTE
  ENVIADO
  FALHOU
  DESATIVADO
  VIA_RD // conversao registrada pelo proprio formulario do RD (LP hospedada no RD)
}

enum OrigemLead {
  LP     // formulario proprio (frontend deste repo)
  RD_LP  // LP hospedada no RD Station, via script injetado
}

model Lead {
  id        String   @id @default(uuid())
  nome      String
  email     String
  telefone  String
  perfil    Perfil
  ies       String

  origem          OrigemLead @default(LP)
  // Valor bruto escolhido na LP do RD ("Direção", "Outro"...) antes do mapeamento
  perfilInformado String?

  // Auditoria da integracao Paciente 360
  hash      String?  @db.Text
  redirectUrl String? @db.Text

  // Auditoria da integracao RD Station Marketing
  rdStatus     RdStatus  @default(PENDENTE)
  rdSyncedAt   DateTime?
  rdEventUuid  String?
  rdError      String?   @db.Text
  rdAttempts   Int       @default(0)

  ip        String?
  userAgent String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
  @@index([rdStatus])
}
