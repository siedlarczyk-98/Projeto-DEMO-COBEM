generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  ALUNO
  PROFESSOR
}

enum RdStatus {
  PENDENTE
  ENVIADO
  FALHOU
  DESATIVADO
}

model Lead {
  id        String   @id @default(uuid())
  nome      String
  email     String
  telefone  String
  perfil    Perfil

  // Auditoria da integracao Paciente 360
  hash      String?  @db.Text
  redirectUrl String? @db.Text

  // Auditoria da integracao RD Station Marketing
  rdStatus     RdStatus  @default(PENDENTE)
  rdSyncedAt   DateTime?
  rdEventUuid  String?
  rdError      String?   @db.Text
  rdAttempts   Int       @default(0)

  ip        String?
  userAgent String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
  @@index([rdStatus])
}
