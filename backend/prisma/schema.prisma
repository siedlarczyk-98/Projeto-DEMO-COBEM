generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  ALUNO
  PROFESSOR
}

model Lead {
  id        String   @id @default(uuid())
  nome      String
  email     String
  telefone  String
  perfil    Perfil

  // Auditoria da integracao Paciente 360
  hash      String?  @db.Text
  redirectUrl String? @db.Text

  ip        String?
  userAgent String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
}
